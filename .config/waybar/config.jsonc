{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 0,
    "expand-center": true,
    "fixed-center": false,

    "modules-left": [
        "custom/power",
        "custom/workspaces",
        "custom/powermode",
        "custom/lid",
        "custom/music",
        "custom/music-toggle",
        "clock",
        "custom/calendar"
    ],
    "modules-center": [
        "custom/center"
    ],
    "modules-right": [
        "custom/wifi",
        "custom/bluetooth",
        "pulseaudio",
        "niri/language",
        "temperature",
        "battery"
    ],

    "custom/workspaces": {
        "exec": "/home/anaidyss/.config/waybar/niri-workspaces",
        "return-type": "json",
        "tooltip": true
    },

    "niri/language": {
        "format": " {}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "clock": {
        "interval": 1,
        "format": "[ {:%H:%M} ]",
        "tooltip-format": "<big>{0:%A, %d.%m.%Y}</big>\n<big>{0:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/calendar": {
        "format": "",
        "tooltip-format": "LMB: calendar · RMB: accounts (Google)",
        "tooltip": true,
        "on-click": "pgrep -x gnome-calendar >/dev/null && pkill -x gnome-calendar || gnome-calendar",
        "on-click-right": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center online-accounts"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
    },

    "temperature": {
        "thermal-zone": 13,
        "critical-threshold": 80,
        "on-click": "/home/anaidyss/.local/bin/veil-sys",
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },

    "custom/wifi": {
        "exec": "/home/anaidyss/.config/waybar/wifi.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true,
        "on-click": "/home/anaidyss/.local/bin/veil-wifi"
    },

    "custom/bluetooth": {
        "exec": "/home/anaidyss/.config/waybar/bluetooth.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true,
        "on-click": "/home/anaidyss/.local/bin/veil-bt",
        "on-click-right": "kitty --title Bluetooth bluetuith"
    },

    "pulseaudio": {
        "format": "{icon} {volume}",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "scroll-step": 3,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "/home/anaidyss/.local/bin/veil-audio"
    },

    "custom/music": {
        "exec": "/home/anaidyss/.config/waybar/music.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "kitty --class veil-music --detach -e veil-music",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    "custom/music-toggle": {
        "exec": "/home/anaidyss/.config/waybar/music-toggle.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/anaidyss/.local/bin/veil-music bar-toggle"
    },

    "custom/powermode": {
        "exec": "/home/anaidyss/.config/waybar/status_pm.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "/home/anaidyss/.config/waybar/toggle_pm.sh",
        "tooltip": true
    },
    
    "custom/lid": {
        "exec": "/home/anaidyss/.config/waybar/status_lid.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "/home/anaidyss/.config/waybar/toggle_lid.sh",
        "tooltip": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": "LMB: V.E.I.L. · RMB: Forest (hyprlock)",
        "on-click": "/home/anaidyss/.local/bin/veil-lock",
        "on-click-right": "/home/anaidyss/.config/niri/lock.sh",
        "on-click-middle": "/home/anaidyss/.local/bin/veil-power"
    },
    "custom/center": {
        "exec": "/home/anaidyss/.config/waybar/center.sh",
        "return-type": "json",
        "escape": false,
        "expand": true,
        "tooltip": true,
        "on-click": "/home/anaidyss/.config/waybar/center-toggle.sh"
    },
    "battery": {
        "interval": 15,
        "on-click": "/home/anaidyss/.local/bin/veil-sys",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}",
        "format-charging": "󰂄 {capacity}",
        "format-plugged": " {capacity}",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    }
}
