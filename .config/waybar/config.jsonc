{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 12,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 10,
    "expand-center": true,
    "fixed-center": false,

    "modules-left": [
        "custom/power",
        "niri/workspaces",
        "custom/powermode",
        "custom/lid",
        "custom/music",
        "custom/music-toggle",
        "clock"
    ],
    "modules-center": [
        "custom/pong",
        "custom/sysmon"
    ],
    "modules-right": [
        "network#wifi",
        "pulseaudio",
        "niri/language",
        "temperature",
        "battery"
    ],

    "niri/workspaces": {
        "format": "{index}",
        "on-click": "activate"
    },

    "niri/language": {
        "format": " {}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "clock": {
        "interval": 1,
        "format": " {:%H:%M}",
        "tooltip-format": "<big>{0:%A, %d.%m.%Y}</big>\n<big>{0:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
    },

    "temperature": {
        "thermal-zone": 13,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },

    "network#wifi": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "on-click": "/home/anaidyss/.local/bin/wifi-menu"
    },

    "pulseaudio": {
        "format": "{icon} {volume}",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "scroll-step": 3,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "custom/music": {
        "exec": "/home/anaidyss/.config/waybar/music.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "kitty --class veil-music --detach -e veil-music",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    "custom/music-toggle": {
        "exec": "/home/anaidyss/.config/waybar/music-toggle.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/anaidyss/.local/bin/veil-music bar-toggle"
    },

    "custom/powermode": {
        "exec": "/home/anaidyss/.config/waybar/status_pm.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "/home/anaidyss/.config/waybar/toggle_pm.sh",
        "tooltip": true
    },
    
    "custom/lid": {
        "exec": "/home/anaidyss/.config/waybar/status_lid.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "/home/anaidyss/.config/waybar/toggle_lid.sh",
        "tooltip": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": "ЛКМ: V.E.I.L. · ПКМ: Forest (hyprlock)",
        "on-click": "/home/anaidyss/.local/bin/veil-lock",
        "on-click-right": "/home/anaidyss/.config/niri/lock.sh"
    },
    "custom/pong": {
        "exec": "/home/anaidyss/.config/waybar/pong.sh 70",
        "return-type": "json",
        "escape": false,
        "expand": true,
        "tooltip": false,
        "on-click": "/home/anaidyss/.config/waybar/center-toggle.sh"
    },
    "custom/sysmon": {
        "exec": "/home/anaidyss/.config/waybar/sysmon.sh",
        "return-type": "json",
        "escape": false,
        "expand": true,
        "tooltip": true,
        "on-click": "/home/anaidyss/.config/waybar/center-toggle.sh"
    },
    "battery": {
        "interval": 15,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}",
        "format-charging": "󰂄 {capacity}",
        "format-plugged": " {capacity}",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    }
}
