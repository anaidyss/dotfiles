input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle,caps:escape"
        }
    }
}


// Chinese input: fcitx5 + Pinyin (toggle with Ctrl+Space).
// Mod+Space is taken by toggle-window-floating, so the fcitx5 trigger is Ctrl+Space.
environment {
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE  "fcitx"
    XMODIFIERS    "@im=fcitx"
    SDL_IM_MODULE "fcitx"
}

spawn-at-startup "waybar"
spawn-at-startup "sh" "-c" "sleep 0.5 && swaybg -i /home/anaidyss/Pictures/Wallpapers/wallpaper.jpg -m fill"
spawn-at-startup "swayosd-server"
spawn-at-startup "fcitx5" "-d" "--replace"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"


// looks: rounding, gaps and border
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"


// Window open/close animation
animations {
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
    }
}

layout {
    gaps 6
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
	proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 1
        active-color "#d87756"
        inactive-color "#3c3c3a"
	urgent-color "#e8c987"
    }


    // shadows off so the border color doesn't bleed under the window
    shadow {
        off
    }
}


// Ask apps (Spotify/Electron, GTK etc.) not to draw their own borders and titlebars —
// only the niri border, like the terminal. Apps need a restart after enabling this.
prefer-no-csd


// Dota 2 (and its gamescope wrapper): no transparency/rounding — the offscreen pass loads the iGPU
window-rule {
    match app-id="dota|Dota"
    match app-id="gamescope"
    geometry-corner-radius 0
    clip-to-geometry false
    opacity 1.0
}

// Window transparency and rounding
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    opacity 1.0
    draw-border-with-background false
}

// Minecraft: no transparency (particles are hard to read through it), rounding stays from the global rule
window-rule {
    match app-id="(?i)minecraft"
    opacity 1.0
}

window-rule {
    match app-id="(?i)firefox"
    opacity 1.0
}

window-rule {
    match app-id="(?i)blockbench"
    opacity 1.0
}

// Claude Code and OpenCode: no transparency, window as in the screenshot
// (all kitty windows; filtered by title). Multiple matches = OR.
window-rule {
    match app-id="kitty" title="(?i)claude"
    match app-id="kitty" title="(?i)opencode"
    match app-id="kitty" title="^OC\b"
    opacity 1.0
}

// keyboard (Mod = Super)
binds {
    // launching stuff
    Mod+Return  { spawn "kitty"; }
    Mod+D       { spawn "fuzzel"; }
    Mod+V       { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; } // clipboard history
    Mod+Z       { spawn "/home/anaidyss/.local/bin/zh-fuzzel"; } // word → card (translation from the dictionary)
    Mod+Shift+Z { spawn "/home/anaidyss/.local/bin/zh-fuzzel" "--ask"; } // word → own translation → card
    Mod+O       { spawn "/home/anaidyss/.local/bin/zh-open"; } // notes in obsidian
    Mod+N       { spawn "/home/anaidyss/.local/bin/zh-pick-note"; } // change the note the capture writes to
    Print       { spawn "/home/anaidyss/.local/bin/screenshot-area.sh"; }
    Mod+Shift+S { spawn "/home/anaidyss/.local/bin/screenshot-area.sh"; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { spawn "/home/anaidyss/.config/niri/lock.sh"; } // hyprlock
    Mod+Shift+V { spawn "/home/anaidyss/.local/bin/veil-lock"; } // veil

    // windows
    Mod+Q       { close-window; }
    Mod+F       { fullscreen-window; }
    Mod+Space   { toggle-window-floating; }
    Mod+R       { switch-preset-column-width; }

    // window height: bigger / smaller / reset (this is how btop gets a bit over half the screen)
    Mod+Alt+J { set-window-height "+5%"; }
    Mod+Alt+K { set-window-height "-5%"; }
    Mod+Alt+R { reset-window-height; }

    // focus hjkl
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // moving around
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }

    // window up/down, kept both shift and ctrl out of habit
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Ctrl+J  { move-window-down; }
    Mod+Ctrl+K  { move-window-up; }

    // stacking
    Mod+W { consume-window-into-column; } // pull the neighbor into the column
    Mod+E { expel-window-from-column; }   // push it back out

    // workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // volume and brightness via swayosd
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute        allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }

    // music via playerctl (also works on the lock screen)
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}

// veil-music — floating music terminal (right click on the player in waybar)
window-rule {
    match app-id="veil-music"

    open-floating true
    min-width 640
    min-height 400
}

// wifi-menu — GTK network picker popup (opens on click on wifi in waybar)
window-rule {
    match app-id="wifi-menu"

    open-floating true
}

// bluetooth-menu — GTK Bluetooth popup (click on bluetooth in waybar)
window-rule {
    match app-id="bluetooth-menu"

    open-floating true
}

// GNOME Calendar — floating window (calendar button in waybar)
window-rule {
    match app-id="org.gnome.Calendar"

    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 720; }
}

// Game mode: while dota2/gamescope is running, game-mode.kdl overrides
// dangerous binds (Mod+Q close-window, Mod+Shift+E quit) with no-ops.
// Managed by the game-mode-watcher service; binds in include take priority
// over the ones defined above (niri >= 25.11).
include optional=true "game-mode.kdl"

// System-wide freeze while gaming: direct scanout of a fullscreen buffer with mismatched
// size/aspect hangs the DRM atomic commit on the iGPU. We composite ourselves.
debug {
    disable-direct-scanout
}
