input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle,caps:escape"
        }
    }
}


// Ввод китайского: fcitx5 + Pinyin (переключение Ctrl+Space).
// Mod+Space занят под toggle-window-floating, поэтому триггер fcitx5 — именно Ctrl+Space.
environment {
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE  "fcitx"
    XMODIFIERS    "@im=fcitx"
    SDL_IM_MODULE "fcitx"
}

// xwayland-satellite 0.8.3 (собран вручную): чинит закрывающиеся меню Steam. Убрать, когда 0.8.3 появится в Fedora.
xwayland-satellite {
    path "/home/anaidyss/.local/share/xws-0.8.3/bin/xwayland-satellite"
}

spawn-at-startup "waybar"
spawn-at-startup "sh" "-c" "sleep 0.5 && swaybg -i /home/anaidyss/Pictures/Wallpapers/wallpaper.jpg -m fill"
spawn-at-startup "swayosd-server"
spawn-at-startup "fcitx5" "-d" "--replace"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"


// Внешний вид: скругления, отступы и обводка
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"


// Анимация открытия/закрытия окон
animations {
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
    }
}

layout {
    gaps 6

    struts {
        left 4
        right 4
        bottom 4
    }
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
	proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 1
        active-color "#d87756"
        inactive-color "#3c3c3a"
	urgent-color "#e8c987"
    }


    // Отключаем тени, чтобы цвет рамки не рассеивался под окно
    shadow {
        off
    }
}


// Просим приложения (Spotify/Electron, GTK и т.п.) не рисовать свои рамки и шапки —
// только рамка niri, как у терминала. После включения нужно перезапустить приложения.
prefer-no-csd


// Dota 2 (и её gamescope-обёртка): без прозрачности/скруглений — offscreen-проход грузит iGPU
window-rule {
    match app-id="dota|Dota"
    match app-id="gamescope"
    geometry-corner-radius 0
    clip-to-geometry false
    opacity 1.0
}

// Прозрачность и скругления окон
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    opacity 1.0
    draw-border-with-background false
}

// Minecraft: убираем прозрачность (мешает читать частицы), скругления остаются от общего правила
window-rule {
    match app-id="(?i)minecraft"
    opacity 1.0
}

window-rule {
    match app-id="(?i)firefox"
    opacity 1.0
}

window-rule {
    match app-id="(?i)blockbench"
    opacity 1.0
}

// Claude Code и OpenCode: убираем прозрачность, окно как на скрине
// (все kitty-окна; фильтруем по заголовку). Несколько match = OR.
window-rule {
    match app-id="kitty" title="(?i)claude"
    match app-id="kitty" title="(?i)opencode"
    match app-id="kitty" title="^OC\b"
    opacity 1.0
}

// клавиатура (Mod = Super)
binds {
    // запуск всего
    Mod+Return  { spawn "kitty"; }
    Mod+D       { spawn "fuzzel"; }
    Mod+V       { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; } // история буфера обмена
    Mod+Z       { spawn "/home/anaidyss/.local/bin/zh-fuzzel"; } // слово → карточка (перевод из словаря)
    Mod+Shift+Z { spawn "/home/anaidyss/.local/bin/zh-fuzzel" "--ask"; } // слово → свой перевод → карточка
    Mod+O       { spawn "/home/anaidyss/.local/bin/zh-open"; } // конспекты в obsidian
    Mod+N       { spawn "/home/anaidyss/.local/bin/zh-pick-note"; } // сменить заметку, куда пишет захват
    Print       { spawn "/home/anaidyss/.local/bin/screenshot-area.sh"; }
    Mod+Shift+S { spawn "/home/anaidyss/.local/bin/screenshot-area.sh"; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { spawn "/home/anaidyss/.config/niri/lock.sh"; } // hyprlock
    Mod+Shift+V { spawn "/home/anaidyss/.local/bin/veil-lock"; } // veil

    // окна
    Mod+Q       { close-window; }
    Mod+F       { fullscreen-window; }
    Mod+Space   { toggle-window-floating; }
    Mod+R       { switch-preset-column-width; }

    // высота окна: больше / меньше / сброс (так btop получает чуть больше половины экрана)
    Mod+Alt+J { set-window-height "+5%"; }
    Mod+Alt+K { set-window-height "-5%"; }
    Mod+Alt+R { reset-window-height; }

    // фокус hjkl
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // перемещение
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }

    // окно вверх/вниз, и shift и ctrl — обе оставил по привычке
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Ctrl+J  { move-window-down; }
    Mod+Ctrl+K  { move-window-up; }

    // стэкинг
    Mod+W { consume-window-into-column; } // затянуть соседа в колонку
    Mod+E { expel-window-from-column; }   // вытолкнуть обратно

    // воркспейсы
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // громкость и яркость через swayosd
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute        allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }

    // музыка через playerctl (работает и на экране блокировки)
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}

// veil-music — плавающий музыкальный терминал (правый клик по плееру в waybar)
window-rule {
    match app-id="veil-music"

    open-floating true
    min-width 640
    min-height 400
}

// wifi-menu — GTK-попап выбора сети (открывается кликом по wifi в waybar)
window-rule {
    match app-id="wifi-menu"

    open-floating true
}

// bluetooth-menu — GTK-попап подключения Bluetooth (клик по блютусу в waybar)
window-rule {
    match app-id="bluetooth-menu"

    open-floating true
}

// GNOME Calendar — плавающее окно (кнопка календаря в waybar)
window-rule {
    match app-id="org.gnome.Calendar"

    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 720; }
}

// Game-mode: пока работает dota2/gamescope, файл game-mode.kdl перезаписывает
// опасные бинды (Mod+Q close-window, Mod+Shift+E quit) на no-op.
// Управляется сервисом game-mode-watcher; binds в include имеют приоритет
// над определёнными выше (niri >= 25.11).
include optional=true "game-mode.kdl"

// Фриз всей системы при игре: direct scanout фуллскрин-буфера несовпадающего
// размера/пропорций вешает DRM atomic commit на iGPU. Композим сами.
debug {
    disable-direct-scanout
}
